#!/bin/bash

# An example `em` script for this continuous evolutionary design method example project
#

# Exit immediately if a command exits with a non-zero status
set -e

export JAVA_HOME=$(readlink -f /usr/bin/java | sed "s:/bin/java::")

# --- Configuration & Paths ---
EM_DIR=".agents/em"
RUN_LOG="$EM_DIR/run-output"
TEST_LOG="$EM_DIR/test-output"
DOC_LOG="$EM_DIR/docs-output"
CHECK_LOG="$EM_DIR/check-output"
DESIGN_LOG="$EM_DIR/design-output"

# --- Helper Functions ---
ensure_em_dir() {
    mkdir -p "$EM_DIR"
}

show_help() {
    echo "Usage: em <command> [options]"
    echo ""
    echo "Supported sub-commands:"
    echo "  setup   Installs prerequisites, checks runtime versions, and resolves dependencies"
    echo "  run     Builds and executes the project (logs to $RUN_LOG)"
    echo "  test    Builds and runs all automated tests (outputs to terminal and $TEST_LOG)"
    echo "  doc     Runs documentation tools (logs warnings/errors to $DOC_LOG)"
    echo "  check   Runs linters and code quality checks (logs report to $CHECK_LOG)"
    echo "  design  Runs design consistency checks (logs report to $DESIGN_LOG)"
    echo "  help    Show this help message"
}

# --- Sub-command Implementations ---

cmd_setup() {
    echo "Starting 'setup' command..."
    
    local missing_java=0
    local missing_maven=0
    
    # Check for Java JDK
    if ! command -v java &> /dev/null; then
        missing_java=1
    fi
    
    # Check for Maven / mvnd
    if ! command -v mvnd &> /dev/null && ! command -v mvn &> /dev/null; then
        missing_maven=1
    fi
    
    # 1) Check if dependencies missing, exit if nothing missing
    if [ $missing_java -eq 0 ] && [ $missing_maven -eq 0 ]; then
        echo "All system dependencies (Java and Maven) are already installed."
        echo "Setup complete."
        return 0
    fi
    
    # 2) Check if running as root and error asking user to run `sudo em setup`
    if [ "$(id -u)" -ne 0 ]; then
        echo "ERROR: System dependencies are missing and root privileges are required to install them."
        echo "Please run this command with sudo:"
        echo "  sudo ./em setup"
        exit 1
    fi
    
    # 3) Install missing dependencies (running as root)
    echo "Installing missing dependencies as root..."
    
    if [ $missing_java -eq 1 ]; then
        echo "Installing default-jdk..."
        apt-get update && apt-get install -y default-jdk
    fi
    
    if [ $missing_maven -eq 1 ]; then
        echo "Installing maven..."
        apt-get update && apt-get install -y maven
    fi
    
    echo "Setup complete."
}

cmd_run() {
    echo "Starting 'run' command..."
    ensure_em_dir

    echo "Executing project with default configurations..." > "$RUN_LOG"

    # Example your project's build and execute logic here
    # This really needs to expose trace logging to the console with a log4j properties file. 
    mvnd compile exec:java -Dexec.mainClass="Greeter" -Dexec.args="$@" | grep -v "Download" | tee -a "$RUN_LOG"
    
    echo "Run complete. Output logged to $RUN_LOG"
}

cmd_test() {
    echo "Starting 'test' command..."
    ensure_em_dir

    echo "Building and running automated tests..." > "$TEST_LOG"
    
    # Example project's test suite command here
    # includes code coverage report
    mvnd clean test jacoco:report | grep -v "Download" | tee -a "$TEST_LOG"
    
    echo "Test suite complete. Output saved to $TEST_LOG"
}

cmd_doc() {
    echo "Starting 'doc' command..."
    ensure_em_dir

    echo "Running documentation tools..." > "$DOC_LOG"
    
    # TODO: Add your project's documentation tool here
    # Redirect stderr (warnings/errors) to the doc log, stdout to /dev/null or terminal
    mvnd javadoc:javadoc | grep -v "Download" | tee -a "$DOC_LOG"

    echo "Documentation generation complete. Warnings/errors logged to $DOC_LOG"
}

cmd_check() {
    echo "Starting 'check' command..."
    ensure_em_dir

    echo "Running linters and code quality checks..." > "$CHECK_LOG"
    
    mvnd spotless:check checkstyle:check spotbugs:check pmd:cpd-check dependency:analyze | grep -v "Download" | tee -a "$CHECK_LOG"

    echo "Code quality check complete. Report written to $CHECK_LOG"
}

cmd_design() {
    echo "Starting 'design' command..."
    ensure_em_dir

    echo "Running design consistency checks..." > "$DESIGN_LOG"

    # This path is true for this specific project but will need to be configured correctly per
    # project. If the project is using a standards conformant agent harness and the skills are installed
    # on a per project basis then this should work.
    .agents/skills/practice-continuous-evolutionary-design/scripts/design-check.R --dir=. "$@" | tee -a "$DESIGN_LOG"

}

cmd_bump() {
    echo "Bumping patch version numbers..."
    mvn build-helper:parse-version versions:set -DnewVersion=\${parsedVersion.majorVersion}.\${parsedVersion.minorVersion}.\${parsedVersion.nextIncrementalVersion} versions:commit

}

# --- Main Argument Parsing ---

# If no arguments are passed, default to help
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

# Parse the first argument as the sub-command
COMMAND="$1"
shift # Remove the command from the argument list, leaving sub-arguments in "$@"

case "$COMMAND" in
    setup)
        cmd_setup "$@"
        ;;
    run)
        cmd_run "$@"
        ;;
    test)
        cmd_test "$@"
        ;;
    doc)
        cmd_doc "$@"
        ;;
    check)
        cmd_check "$@"
        ;;
    design)
        cmd_design "$@"
        ;;
    bump)
        cmd_bump "$@"
        ;;
    --help|help|-h)
        show_help
        ;;
    *)
        echo "Error: Unknown command '$COMMAND'" >&2
        echo "" >&2
        show_help >&2
        exit 1
        ;;
esac
</file>

