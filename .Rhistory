.traverser = function(links) {
return(
function(df, relationship, reverse = FALSE) {
if (isTRUE(reverse)) {
tmp = df %>% dplyr::inner_join(links, by=c("path"="target")) %>%
dplyr::filter(type == relationship) %>%
dplyr::select(path = target)
} else {
tmp = df %>% dplyr::inner_join(links, by=c("path"="source")) %>%
dplyr::filter(type == relationship) %>%
dplyr::select(path = target)
}
return(tmp)
}
)
}
